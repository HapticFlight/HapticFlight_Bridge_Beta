            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "if (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !$prop('DcsExtraTelemetryPlugin.DCSExtra.Has.WeaponEffects')) return 30;\nvar weaponClass = String($prop('DcsExtraTelemetryPlugin.DCSExtra.WeaponClass') || '').toUpperCase();\nvar detected = Number($prop('DcsExtraTelemetryPlugin.DCSExtra.WeaponRateHz'));\n// The AH-6J recording identifies this mounted gun as UNKNOWN but supplies a\n// stable 40-60 Hz detected cadence. Use it only for a bounded heavy-gun cue.\nif (weaponClass === 'HEAVY_GUN' && isFinite(detected) && detected >= 20 && detected <= 80) return detected;\nvar name = String($prop('DcsExtraTelemetryPlugin.DCSExtra.LastFiredWeaponName') || '').toLowerCase();\nif (name.indexOf('m230') >= 0) return 625 / 60;\nif (name.indexOf('m3p') >= 0) return 1100 / 60;\nif (name.indexOf('hmp400') >= 0) return 1025 / 60;\nreturn 30;",
