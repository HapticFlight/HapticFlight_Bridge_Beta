        {
          "ContainerType": "CustomEffectContainer",
          "IsEnabled": true,
          "Gain": 24,
          "Description": "AH-6 HMP400 recoil onset",
          "FrontLeftFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "var version = String($prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.EngineVersion') || '').split('.');\nvar major = Number(version[0]), minor = Number(version[1]), patch = Number(version[2] || 0);\nif (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !(major > 1 || (major === 1 && (minor > 7 || (minor === 7 && patch >= 1))))) return 0;\nvar raw = $prop('DcsExtraTelemetryPlugin.DCSExtra.Has.WeaponEffects') ? Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Weapon.HeavyGun.Intensity'))) : 0;\nvar dt = Number($prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Timing.DeltaSeconds.Intensity'));\nif (!isFinite(dt) || dt <= 0 || dt > 0.25) dt = 1 / 60;\nvar prior = Number(root[\"ah6HeavyGunPrior\"] || 0);\nvar kick = Number(root[\"ah6HeavyGunKick\"] || 0);\nif (raw > 0.20 && prior <= 0.05) kick = 1;\nelse kick = kick * Math.exp(-dt / 0.12);\nroot[\"ah6HeavyGunPrior\"] = raw;\nroot[\"ah6HeavyGunKick\"] = kick;\nreturn 60 * Math.max(0, Math.min(1, kick));",
            "PreExpression": "root[\"ah6HeavyGunPrior\"] = 0; root[\"ah6HeavyGunKick\"] = 0;"
