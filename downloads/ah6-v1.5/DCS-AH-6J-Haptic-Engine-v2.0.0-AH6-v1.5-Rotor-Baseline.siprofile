            "Expression": "var version = String($prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.EngineVersion') || '').split('.');\nvar major = Number(version[0]), minor = Number(version[1]), patch = Number(version[2] || 0);\nif (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !(major > 1 || (major === 1 && (minor > 7 || (minor === 7 && patch >= 1))))) return 0;\nvar skid = Math.max(\n  Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Skid.FrontLeft.Envelope'))),\n  Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Skid.FrontRight.Envelope'))),\n  Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Skid.RearLeft.Envelope'))),\n  Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Skid.RearRight.Envelope'))));\nvar landing = Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.AH6.LightLanding.Envelope')));\n// Preserve soft and single-skid texture.  Above a firm landing, reserve event\n// headroom for the body impact rather than summing several full-scale bursts.\nvar priorityDuck = Math.max(0, Math.min(1, (landing - 0.35) / 0.35));\n// The existing landing multiplier keeps contact detail present on soft landings;\n// priorityDuck silences only the concurrent hard-landing stack.\nreturn 55 * skid * (1 - 0.65 * landing) * (1 - priorityDuck);",
