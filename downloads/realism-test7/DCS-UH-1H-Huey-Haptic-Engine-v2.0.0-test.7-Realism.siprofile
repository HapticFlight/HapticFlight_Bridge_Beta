            "Interpreter": 1,
            "Expression": "if (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !$prop('DcsExtraTelemetryPlugin.DCSExtra.Has.RotorDynamics')) return 1;\r\nreturn Math.max(1, Math.min(80, ($prop('DcsExtraTelemetryPlugin.DCSExtra.MainRotorHz') * (String($prop('DcsExtraTelemetryPlugin.DCSExtra.RotorSource')) == 'UH1RotorGaugeProxy' ? 360 / 324 : 1))));",
