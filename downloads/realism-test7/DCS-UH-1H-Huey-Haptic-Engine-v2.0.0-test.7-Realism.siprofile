            "Expression": "var name = String($prop('DcsExtraTelemetryPlugin.DCSExtra.LastFiredWeaponName') || '').toLowerCase();\nvar rate = 25;\nif (name.indexOf('m230') >= 0) rate = 625 / 60;\nif (name.indexOf('m3p') >= 0) rate = 1100 / 60;\n\nif (name.indexOf('m134 door gun') >= 0) rate = 100;\nreturn Math.max(1, Math.min(80, rate * 0.5));"
