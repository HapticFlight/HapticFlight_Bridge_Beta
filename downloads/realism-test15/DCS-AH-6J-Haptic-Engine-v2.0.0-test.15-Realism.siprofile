            "Expression": "var name = String($prop('DcsExtraTelemetryPlugin.DCSExtra.LastFiredWeaponName') || '').toLowerCase();\nvar rate = 25;\nif (name.indexOf('m230') >= 0) rate = 625 / 60;\nif (name.indexOf('m3p') >= 0) rate = 1100 / 60;\nif (name.indexOf('m134') >= 0) rate = 4000 / 60; if (name.indexOf('hmp400') >= 0) rate = 1025 / 60;\n\nreturn Math.max(1, Math.min(80, rate * 1));",
