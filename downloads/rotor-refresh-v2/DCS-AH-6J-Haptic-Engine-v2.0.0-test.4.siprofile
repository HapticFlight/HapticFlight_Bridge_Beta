            "Interpreter": 1,
            "Expression": "if (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !$prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.EngineVersion')) return 0;\nif (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected')) return 0;\nvar target = 0;\nif ($prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') && $prop('DcsExtraTelemetryPlugin.DCSExtra.Has.WeaponEffects')) {\n    target = Math.min(70, 70 * $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Weapon.HeavyGun.Intensity'));\n}\nvar coefficient = target > root[\"heavyGunRhythmLevel\"] ? 0.28 : 0.12;\nroot[\"heavyGunRhythmLevel\"] = root[\"heavyGunRhythmLevel\"] +\n    (target - root[\"heavyGunRhythmLevel\"]) * coefficient;\nif (target === 0 && root[\"heavyGunRhythmLevel\"] < 0.05) root[\"heavyGunRhythmLevel\"] = 0;\nreturn Math.max(0, Math.min(70, root[\"heavyGunRhythmLevel\"]));",
