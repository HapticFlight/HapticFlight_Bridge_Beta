          "Description": "AH-6J ETL transition (smoothed onset / release)",
          "FrontLeftFormula": {
            "JSExt": 0,
            "Interpreter": 1,
            "Expression": "var version = String($prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.EngineVersion') || '').split('.');\nvar major = Number(version[0]), minor = Number(version[1]), patch = Number(version[2] || 0);\nif (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Connected') || !(major > 1 || (major === 1 && (minor > 7 || (minor === 7 && patch >= 1))))) return 0;\nif (!$prop('DcsExtraTelemetryPlugin.DCSExtra.Has.AerodynamicEffects')) return 0;\nvar raw = Math.max(0, Math.min(1, $prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Aerodynamic.TranslationalLift.Intensity')));\nvar target = 60 * Math.pow(raw, 0.60);\nvar dt = Number($prop('DcsExtraTelemetryPlugin.DCSExtra.Haptic.Timing.DeltaSeconds.Intensity'));\nif (!isFinite(dt) || dt <= 0 || dt > 0.25) dt = 1 / 60;\nvar prior = Number(root[\"ah6EtlEnvelope\"] || 0);\nvar timeConstant = target > prior ? 0.15 : 0.40;\nvar smoothed = prior + (target - prior) * (1 - Math.exp(-dt / timeConstant));\nif (target <= 0 && smoothed < 0.05) smoothed = 0;\nroot[\"ah6EtlEnvelope\"] = smoothed;\nreturn Math.max(0, Math.min(100, smoothed));",
