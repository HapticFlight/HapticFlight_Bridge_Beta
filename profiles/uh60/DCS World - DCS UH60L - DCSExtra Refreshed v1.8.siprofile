                                                                                         "Expression":  "if (!$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Connected\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.RotorDynamics\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.RotorRunning\u0027)) return 0;\r\nvar load = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.RotorLoadIntensity\u0027)));\nvar maneuver = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ManeuverResponseIntensity\u0027)));\nvar lateral = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.LateralManeuverIntensity\u0027)));\nvar nr = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.MainRotorRpmPct\u0027) / 100));\nvar governed = Math.max(0, Math.min(1, (nr - 0.15) / 0.80));\ngoverned = governed * governed * (3 - 2 * governed);\nif ($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.WeaponBurstActive\u0027)) { maneuver *= 0.78; lateral *= 0.35; }\nvar control = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ControlResponseIntensity\u0027)));\r\nvar vv = Math.abs($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.VerticalVelocityMps\u0027));\r\nvar vertical = Math.max(0, Math.min(1, (vv - 1.5) / 8.5));\r\nreturn Math.min(55, 3 + 11 * governed + 15 * load + 17 * maneuver + 10 * lateral + 9 * control + 5 * vertical);",
