                                                                "FrontLeftFormula":  {
                                                                                         "JSExt":  0,
                                                                                         "Interpreter":  1,
                                                                                         "Expression":  "if (!$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Connected\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.RotorDynamics\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.RotorRunning\u0027)) return 0;\nvar load = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.RotorLoadIntensity\u0027)));\nvar maneuver = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ManeuverLoadIntensity\u0027)));\nvar vv = Math.abs($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.VerticalVelocityMps\u0027));\nvar vertical = Math.max(0, Math.min(1, (vv - 1.5) / 8.5));\nreturn Math.min(55, 10 + 16 * load + 20 * maneuver + 9 * vertical);",
