                                                                                                  "Expression":  "if (!$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Connected\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.RotorDynamics\u0027)) return 1;\nreturn Math.max(1, Math.min(80, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.MainRotorHz\u0027)));",
