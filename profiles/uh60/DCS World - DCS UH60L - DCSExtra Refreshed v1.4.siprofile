                                                                "FrontLeftFormula":  {
                                                                                         "JSExt":  0,
                                                                                         "Interpreter":  1,
                                                                                         "Expression":  "if (!$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Connected\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.AerodynamicEffects\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.AirData\u0027) || $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.OnGround\u0027)) return 0;\nvar maneuver = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ManeuverLoadIntensity\u0027)));\nvar control = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ControlResponseIntensity\u0027)));\nvar governor = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.EngineGovernorResponseIntensity\u0027)));\nvar vv = Math.abs($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.VerticalVelocityMps\u0027));\nvar vertical = Math.max(0, Math.min(1, (vv - 1.5) / 8.5));\nvar combined = 1 -\n    (1 - maneuver) *\n    (1 - control * 0.85) *\n    (1 - governor * 0.45) *\n    (1 - vertical * 0.40);\ncombined = Math.max(0, Math.min(1, combined));\nreturn Math.min(85, 85 * Math.pow(combined, 0.78));",
