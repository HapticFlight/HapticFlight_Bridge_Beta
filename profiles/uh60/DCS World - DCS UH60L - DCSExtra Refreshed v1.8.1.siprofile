                                                                                         "Expression":  "if (!$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Connected\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.AerodynamicEffects\u0027) || !$prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.Has.AirData\u0027) || $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.OnGround\u0027)) return 0;\nvar maneuver = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ManeuverResponseIntensity\u0027)));\nvar lateral = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.LateralManeuverIntensity\u0027)));\nvar control = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.ControlResponseIntensity\u0027)));\nif ($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.WeaponBurstActive\u0027)) {\n    maneuver *= 0.78;\n    lateral *= 0.35;\n    control *= 0.78;\n}\nvar governor = Math.max(0, Math.min(1, $prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.EngineGovernorResponseIntensity\u0027)));\nvar vv = Math.abs($prop(\u0027DcsExtraTelemetryPlugin.DCSExtra.VerticalVelocityMps\u0027));\nvar vertical = Math.max(0, Math.min(1, (vv - 1.5) / 8.5));\nvar combined = 1 -\n    (1 - maneuver) *\n    (1 - lateral * 0.68) *\n    (1 - control * 0.85) *\n    (1 - governor * 0.45) *\n    (1 - vertical * 0.40);\ncombined = Math.max(0, Math.min(1, combined));\nvar target = 64 * Math.pow(combined, 0.90);\nvar coefficient = target \u003e root[\"maneuverBody\"] ? 0.12 : 0.04;\nroot[\"maneuverBody\"] = root[\"maneuverBody\"] + (target - root[\"maneuverBody\"]) * coefficient;\nif (target === 0 \u0026\u0026 root[\"maneuverBody\"] \u003c 0.05) root[\"maneuverBody\"] = 0;\nreturn Math.max(0, Math.min(64, root[\"maneuverBody\"]));",
