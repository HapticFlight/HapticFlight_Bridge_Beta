<!--
    GlassStyles.xaml: control styles for the dark glass dashboard.

    Every brush is a DynamicResource written by App.ApplyTheme() from
    GlassThemePalette.DarkGlass. Style keys that MainWindow and its code-behind already use
    (Card, PrimaryButton, NavButton, ActiveNavButton, AnalysisTabButton, ...) are kept so
    existing markup and style swaps pick up the new look; the dashboard adds StatTile,
    DeltaBadge, PeriodPill, PanelTitle and friends.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="GlassCardSurfaceBrush" Color="#9E3A3A3E" />
    <SolidColorBrush x:Key="GlassEdgeStrokeBrush" Color="#12FFFFFF" />

    <!-- ============ Panels ============ -->

    <!-- A calm navy panel: enough separation for dense technical content without
         turning the launcher into a collection of floating SaaS tiles. -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource GlassSurfaceTopColor}" Offset="0" /><GradientStop Color="{DynamicResource GlassSurfaceBottomColor}" Offset="1" /></LinearGradientBrush></Setter.Value></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="21,22" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource GlassCard}" />

    <Style x:Key="GlassCardStrong" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceStrong}" />
    </Style>

    <!-- The large rounded sheet that holds a whole page, like the reference dashboard. -->
    <Style x:Key="ShellPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShellSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="MinHeight" Value="73" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource StatTile}" />

    <Style x:Key="ActionRequiredCard" TargetType="Border" BasedOn="{StaticResource GlassCardStrong}" />

    <Style x:Key="ActionCallout" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="GlassEdgeHighlight" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- ============ Buttons ============ -->

    <Style x:Key="GlassButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" CornerRadius="18" Margin="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary action: a compact rounded rectangle.  Pills are reserved for
         statuses and segmented controls, as in the supplied reference UI. -->
    <Style x:Key="GlassButtonBase" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassButtonFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ButtonContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DisabledBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="{DynamicResource DisabledForeground}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SecondaryButtonPressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonBase}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}" />

    <!-- Primary action: the electric-blue HapticFlight call to action. -->
    <Style x:Key="GlassPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="18,7" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryPressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="{DynamicResource BadBadgeBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlineDangerButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    </Style>

    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Padding" Value="13,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="ComponentActionButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}" /><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource SecondaryButtonPressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComponentRemoveButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource BadBadgeBackground}" /><Setter Property="Foreground" Value="{DynamicResource Danger}" /><Setter Property="BorderBrush" Value="{DynamicResource Danger}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style x:Key="ReferencePillButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}" />
    <Style x:Key="ReferencePrimaryPillButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}" />

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedAccent}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- A clickable list row (recent flights). The selected variant is the open flight. -->
    <Style x:Key="ListRowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassButtonFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListRowButtonSelected" TargetType="Button" BasedOn="{StaticResource ListRowButton}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonPressed}" />
    </Style>

    <!-- ============ Badges and chips ============ -->

    <!-- Change badges on stat tiles: +3 / +12% / clean. -->
    <Style x:Key="DeltaBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GoodBadgeBackground}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style x:Key="DeltaBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Success}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="InstalledBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GoodBadgeBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TelemetryPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="6,4,14,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="FilterChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,5" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Square tile with a short aircraft code, used in the My aircraft list. -->
    <Style x:Key="AircraftTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="AircraftTileText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ Segmented pills (period selector, analysis views, appearance) ============ -->

    <Style x:Key="GlassPillBar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="13,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PillButtonActive" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AnalysisTabButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="MinWidth" Value="96" />
    </Style>
    <Style x:Key="AnalysisTabButtonActive" TargetType="Button" BasedOn="{StaticResource PillButtonActive}">
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <!-- Period selector (This week / This month / All time) is a radio group. -->
    <Style x:Key="PeriodPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassButtonFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PillBorder" Height="28" Padding="13,0" CornerRadius="14" Background="Transparent"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SecondaryButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource Primary}" />
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Persistent sidebar navigation ============ -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassButtonFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="11">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ActiveNavBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>

    <Style x:Key="GlassSidebar" TargetType="Border" BasedOn="{StaticResource GlassCard}" />

    <Style x:Key="NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource SelectedAccent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ Type ============ -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,4,0,16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}" />
    <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}" />
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- Readouts for ports, paths and versions. -->
    <Style x:Key="MonoReadout" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="HoverInspector" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceSubtle}" />
    </Style>

    <!-- ============ Search box ============ -->

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Height="34" CornerRadius="17" Background="{DynamicResource GlassSurface}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Window chrome ============ -->

    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E5484D" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource WindowButton}" />

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
