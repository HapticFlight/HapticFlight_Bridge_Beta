                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Effect timeline" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="TimelineSummaryText" Text="Every recorded effect" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="10,3,0,0" /></StackPanel><WrapPanel Grid.Column="1"><Button Style="{StaticResource CompactButton}" Content="−" Click="TimelineZoomOutButton_Click" /><Button Style="{StaticResource CompactButton}" Content="Reset" Click="TimelineResetButton_Click" /><Button Style="{StaticResource CompactButton}" Content="+" Click="TimelineZoomInButton_Click" /></WrapPanel></Grid>
                                            <TextBlock Grid.Row="1" Text="Bar length is duration · brightness is intensity · Ctrl + wheel zooms · Shift + wheel pans" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,4,0,8" />
