                                        <Button Style="{StaticResource SecondaryButton}" Content="Open profiles folder" Margin="0" HorizontalAlignment="Left" Click="OpenProfilesFolderButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                            <TextBlock Text="Options" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Display, local connection, and application update preferences." Style="{StaticResource PageSubtitle}" />
