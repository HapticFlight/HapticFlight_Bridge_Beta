                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryAirframe}" Margin="0,3,5,0" /><TextBlock Text="Airframe" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryRotor}" Margin="0,3,5,0" /><TextBlock Text="Rotor" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryGround}" Margin="0,3,5,0" /><TextBlock Text="Ground" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryWeapons}" Margin="0,3,5,0" /><TextBlock Text="Weapons" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" />
