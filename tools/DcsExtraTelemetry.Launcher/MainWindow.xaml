                                                        <TextBlock x:Name="TimelineWindowText" Grid.Column="2" Text="Fit" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    </StackPanel>

                                    <Border x:Name="PhaseTabPanel" Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,11" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0">
                                                <TextBlock Text="INTENSITY" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,8,0" />
                                                <Border Width="20" Height="10" CornerRadius="2" Background="{DynamicResource ChartLane}" Margin="0,1,3,0" />
                                                <Border Width="20" Height="10" CornerRadius="2" Background="{DynamicResource ChartCategoryAirframe}" Opacity="0.4" Margin="0,1,3,0" />
                                                <Border Width="20" Height="10" CornerRadius="2" Background="{DynamicResource ChartCategoryAirframe}" Opacity="0.7" Margin="0,1,3,0" />
                                                <Border Width="20" Height="10" CornerRadius="2" Background="{DynamicResource ChartCategoryAirframe}" Margin="0,1,8,0" />
                                                <TextBlock Text="0 → 100%" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Effects by flight phase" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="PhaseMatrixSummaryText" Text="Shade shows peak strength in each detected phase" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="10,3,0,0" /></StackPanel>
                                            <TextBlock Grid.Row="1" Text="Each column summarizes a detected phase · brighter cells indicate stronger output · click a row to isolate it" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,4,0,8" />
                                            <ScrollViewer Grid.Row="2" x:Name="PhaseMatrixScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="AnalysisScrollViewer_PreviewMouseWheel" MaxHeight="560"><Grid x:Name="PhaseMatrixHost" MinWidth="650" /></ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="LoadTabPanel" Grid.Row="4" Margin="0,0,0,10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Card}" Margin="0" Padding="14,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="105" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Combined load" FontSize="13.5" FontWeight="SemiBold" /><TextBlock x:Name="ConcurrencySummaryText" Grid.Row="1" Text="Simultaneous effect activity by category" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,3,0,7" /><Grid x:Name="CombinedLoadHost" Grid.Row="2" /><WrapPanel Grid.Row="3" Margin="0,7,0,0"><TextBlock Text="● Airframe" Foreground="{DynamicResource ChartCategoryAirframe}" Margin="0,0,14,0"/><TextBlock Text="● Ground" Foreground="{DynamicResource ChartCategoryGround}" Margin="0,0,14,0"/><TextBlock Text="● Weapons" Foreground="{DynamicResource ChartCategoryWeapons}" Margin="0,0,14,0"/><TextBlock Text="● Rotor / powertrain" Foreground="{DynamicResource ChartCategoryRotor}"/></WrapPanel></Grid></Border>
                                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Strongest effects" FontSize="13.5" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="Secondary reference · click to locate" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,3,0,5" /><StackPanel x:Name="StrongestEffectsPanel" Grid.Row="2" /></Grid></Border>
                                    </Grid>

                                    <Border x:Name="TelemetryTabPanel" Grid.Row="7" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,11" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="220" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Recorded telemetry" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="TelemetrySignalSourceText" Text="Recorded telemetry; use as a tuning reference." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="TelemetrySignalComboBox" Style="{StaticResource EffectFilterComboBox}" Width="230" Height="32" SelectionChanged="TelemetrySignalComboBox_SelectionChanged" /><CheckBox x:Name="NormalizeTelemetryCheckBox" Content="Normalize" Margin="10,0,0,0" VerticalAlignment="Center" Checked="NormalizeTelemetryCheckBox_Changed" Unchecked="NormalizeTelemetryCheckBox_Changed" /></StackPanel></Grid>
                                            <TextBlock Grid.Row="1" Text="Click a point to move the replay cursor. Values are recorded telemetry except the explicitly modelled combined-load signal." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,5,0,8" />
                                            <Border Grid.Row="2" Background="{DynamicResource ChartBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5" Padding="6"><Canvas x:Name="TelemetryCanvas" SizeChanged="TelemetryCanvas_SizeChanged" MouseLeftButtonUp="TelemetryCanvas_MouseLeftButtonUp" /></Border>
                                            <TextBlock x:Name="TelemetryCursorText" Grid.Row="3" Text="Move the replay cursor or select a point to inspect the trace." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,7,0,0" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="DebriefTabPanel" Grid.Row="8" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,11" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="220" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Flight debrief" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="DebriefSummaryText" Text="Recorded data and modelled effect episodes." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,3,0,0" /></StackPanel><ComboBox x:Name="CompareRecordingComboBox" Grid.Column="1" Style="{StaticResource EffectFilterComboBox}" Width="235" Height="32" SelectionChanged="CompareRecordingComboBox_SelectionChanged" ToolTip="Compare with a recent recording" /></Grid>
                                            <ItemsControl x:Name="DebriefFindingsList" Grid.Row="1" Margin="0,10,0,6" />
                                            <TextBlock Grid.Row="2" Text="Effect events · select a row to jump the replay cursor" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,2,0,6" />
                                            <DataGrid x:Name="DebriefEventsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" IsReadOnly="True" SelectionChanged="DebriefEventsGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                                <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="70" /><DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="90" /><DataGridTextColumn Header="Effect" Binding="{Binding Effect}" Width="*" /><DataGridTextColumn Header="Peak" Binding="{Binding PeakText}" Width="55" /><DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="70" /><DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="75" /></DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="ComparisonSummaryText" Grid.Row="4" Text="Select a recent recording to compare key metrics." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="5" Style="{StaticResource HoverInspector}">
                                        <TextBlock x:Name="AnalysisHoverInspectorText" Text="Hover over a chart item to inspect its time, phase, frequency, and intensity." Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </Border>

                                    <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0" Padding="14,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal"><Border x:Name="SelectedEffectSwatch" Width="10" Height="10" CornerRadius="5" Margin="0,4,8,0" /><TextBlock x:Name="SelectedEffectNameText" Text="Select an effect" FontSize="15" FontWeight="SemiBold" /></StackPanel>
                                                <TextBlock x:Name="SelectedEffectStatsText" Text="Frequency · peak · bursts" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,5,0,0" />
                                                <TextBlock x:Name="SelectedEffectPropertyText" Text="Modelled from the recording and profile logic" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Activity across the flight" FontSize="11.5" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource ChartBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="3" Margin="0,6,0,0" Padding="3"><Canvas x:Name="SelectedEffectCanvas" Height="32" SizeChanged="DashboardCanvas_SizeChanged" /></Border>
                                            </StackPanel>
                                            <Border Grid.Column="3" Width="1" Background="{DynamicResource PanelBorder}" />
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="SimHub tuning handoff" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" />
                                                <TextBlock x:Name="TuningEvidenceText" Text="Analyze a recording to build a tuning worksheet." FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TuningBoundaryText" Text="Bridge does not trigger effects, alter a SimHub profile, or measure shaker output." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,7" />
                                                <WrapPanel><Button x:Name="SelectedEffectPreviousButton" Style="{StaticResource CompactButton}" Content="&#x2039; Previous" ToolTip="Previous effect" Click="SelectedEffectPreviousButton_Click" /><Button x:Name="SelectedEffectNextButton" Style="{StaticResource CompactButton}" Content="Next &#x203A;" ToolTip="Next effect" Click="SelectedEffectNextButton_Click" /><Button x:Name="ExportEffectReportButton" Style="{StaticResource CompactButton}" Content="Export report" Click="ExportEffectReportButton_Click" /></WrapPanel>
                                                <WrapPanel Margin="0,6,0,0"><Button Style="{StaticResource CompactButton}" Content="Copy SimHub handoff" ToolTip="Copies instructions for testing this selected effect in SimHub" Click="CopySimHubHandoffButton_Click" /><Button Style="{StaticResource CompactButton}" Content="Copy A/B worksheet" ToolTip="Copies a one-change tuning worksheet" Click="CopyTuningWorksheetButton_Click" /></WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ==================== Aircraft ==================== -->
                        <StackPanel x:Name="AircraftPage" Visibility="Collapsed">
                            <TextBlock Text="Aircraft" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="The haptic profiles in this package, and the aircraft you have flown with them." Style="{StaticResource PageSubtitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Flown aircraft" Style="{StaticResource PanelTitle}" />
                                        <TextBlock x:Name="AircraftEmptyText" Text="Aircraft appear here after you record or import a flight." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
                                        <WrapPanel x:Name="AircraftTilesPanel" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Bundled profiles" Style="{StaticResource PanelTitle}" />
