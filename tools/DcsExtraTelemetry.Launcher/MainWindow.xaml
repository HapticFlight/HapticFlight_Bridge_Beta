                                                    <Grid Grid.Row="1" Margin="8,0,20,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="Timeline" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" VerticalAlignment="Center" />
