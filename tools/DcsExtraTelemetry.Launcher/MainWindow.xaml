<Window x:Class="DcsExtraTelemetry.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HapticFlight Bridge" Icon="Assets/HapticFlightOrangeIcon.ico" Width="740" Height="440" MinWidth="720" MinHeight="410"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot" Background="{DynamicResource BackdropBase}">
        <!-- Soft pools of warm and cool light: a stand-in for the blurred photo behind the glass. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.2" GradientOrigin="0.12,0.2" RadiusX="0.6" RadiusY="0.55">
                    <GradientStop Color="{DynamicResource BackdropWarmColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.88,0.12" GradientOrigin="0.88,0.12" RadiusX="0.5" RadiusY="0.6">
                    <GradientStop Color="{DynamicResource BackdropTealColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.6,1.05" GradientOrigin="0.6,1.05" RadiusX="0.7" RadiusY="0.5">
                    <GradientStop Color="{DynamicResource BackdropPurpleColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="WindowScaleViewbox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="WindowFrame" Background="Transparent" BorderThickness="0" CornerRadius="10">
        <Grid x:Name="AmbientBackdrop" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Top bar: logo, navigation, search, connection, window buttons ============ -->
            <Grid Grid.Row="0" Margin="22,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Primary}" VerticalAlignment="Center" ToolTip="HapticFlight Bridge">
                    <Path Data="M3.5,14 L7.5,14 L10.2,7.5 L15.4,20.5 L18.4,12 L20.2,14 L24.5,14" Stroke="White" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="28" Height="28" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                </Border>

                <StackPanel x:Name="TopNavigationPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource ActiveNavButton}" Margin="0,0,14,0" Click="OverviewNavButton_Click" AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewNavIcon" Style="{StaticResource NavIcon}" Text="&#xE80F;" Visibility="Collapsed" /><TextBlock x:Name="OverviewNavLabel" Text="Dashboard" /></StackPanel>
                    </Button>
                    <Button x:Name="TelemetryNavButton" Style="{StaticResource NavButton}" Margin="0,0,14,0" Click="TelemetryNavButton_Click" AutomationProperties.Name="Flights">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="TelemetryNavIcon" Style="{StaticResource NavIcon}" Text="&#xE709;" Visibility="Collapsed" /><TextBlock x:Name="TelemetryNavLabel" Text="Flights" /></StackPanel>
                    </Button>
                    <Button x:Name="AircraftNavButton" Style="{StaticResource NavButton}" Margin="0,0,14,0" Click="AircraftNavButton_Click" AutomationProperties.Name="Aircraft">
                        <TextBlock Text="Aircraft" />
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Margin="0,0,14,0" Click="SettingsNavButton_Click" AutomationProperties.Name="Options">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="SettingsNavIcon" Style="{StaticResource NavIcon}" Text="&#xE713;" Visibility="Collapsed" /><TextBlock x:Name="SettingsNavLabel" Text="Options" /></StackPanel>
                    </Button>
                    <Button x:Name="InstallationNavButton" Style="{StaticResource NavButton}" Margin="0,0,14,0" Click="InstallationNavButton_Click" AutomationProperties.Name="Setup" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="InstallationNavIcon" Style="{StaticResource NavIcon}" Text="&#xE896;" Visibility="Collapsed" /><TextBlock x:Name="InstallationNavLabel" Text="Setup" /></StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButton}" Click="DiagnosticsNavButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="DiagnosticsNavIcon" Style="{StaticResource NavIcon}" Text="&#xE90F;" /><TextBlock x:Name="DiagnosticsNavLabel" Text="Diagnostics" /></StackPanel>
                    </Button>
                </StackPanel>

                <TextBox x:Name="FlightSearchTextBox" Grid.Column="3" Style="{StaticResource SearchBox}" Tag="Search flights" Width="120" VerticalAlignment="Center" Margin="0,0,8,0"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True" KeyDown="FlightSearchTextBox_KeyDown" TextChanged="FlightSearchTextBox_TextChanged"
                         AutomationProperties.Name="Search flights by aircraft or map" />

                <StackPanel x:Name="TopStatusPill" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0" ToolTip="Local connection on this PC. Telemetry never leaves your computer.">
                    <Ellipse x:Name="TitleStatusIndicator" Width="8" Height="8" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleStatusText" Text="Setup required" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Danger}" />
                        <TextBlock x:Name="TitleStatusDetailText" Text="Checking setup" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeWindowButton_Click" />
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaximizeWindowButton_Click" />
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="CloseWindowButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Page sheet ============ -->
            <Border Grid.Row="1" Style="{StaticResource ShellPanel}" Margin="14,0,14,14" Padding="0">
                <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
                    <StackPanel x:Name="ActionArea" Margin="12">

                        <!-- ==================== Dashboard ==================== -->
                        <Grid x:Name="OverviewPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="DashboardMainPanel" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                <TextBlock Text="Flight dashboard" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="DashboardSetupPanel" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.25*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="SetupBadge" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Danger}" BorderBrush="{DynamicResource DangerHover}" BorderThickness="2" VerticalAlignment="Top">
                                            <TextBlock x:Name="SetupBadgeGlyph" Text="!" FontWeight="ExtraBold" FontSize="17" Foreground="{DynamicResource DangerText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Setup" Style="{StaticResource PanelTitle}" />
                                            <TextBlock x:Name="SetupSummaryText" Text="Checking" Foreground="{DynamicResource Warning}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="HomeProfileIndicator" Width="7" Height="7" Fill="{DynamicResource Danger}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="DCS profile" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeProfileNameText" Text="No DCS profile selected" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=HomeProfilePathText}" />
                                                <TextBlock x:Name="HomeProfilePathText" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock x:Name="HomeProfileStateText" Grid.Column="2" Text="Required" Foreground="{DynamicResource Danger}" FontSize="11" FontWeight="Bold" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DashboardSimHubIndicator" Width="7" Height="7" Fill="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="SimHub" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeSimHubPathText" Text="Not detected" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Click="ChooseSimHubButton_Click" VerticalAlignment="Top" Padding="2,0"><TextBlock x:Name="HomeSimHubStateText" Text="Choose..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warning}" /></Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="DCS hook" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeHookStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button x:Name="HomeHookInstallButton" Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="Install" Margin="0" VerticalAlignment="Center" Click="InstallDcsHookButton_Click" />
                                            <Border x:Name="HomeHookInstalledBadge" Grid.Column="1" Style="{StaticResource InstalledBadge}" Visibility="Collapsed"><TextBlock Text="Installed" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="Bold" /></Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="SimHub plugin" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomePluginStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button x:Name="HomePluginInstallButton" Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="Install" Margin="0" VerticalAlignment="Center" Click="InstallSimHubPluginButton_Click" />
                                            <Border x:Name="HomePluginInstalledBadge" Grid.Column="1" Style="{StaticResource InstalledBadge}" Visibility="Collapsed"><TextBlock Text="Installed" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="Bold" /></Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="App release" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="HomePackageVersionText" Grid.Column="1" Text="Loading" FontSize="10" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <Border x:Name="HomeRequiredActionCard" Background="{DynamicResource GlassSurfaceSubtle}" CornerRadius="10" Padding="11,9" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="HomeRequiredActionTitle" Text="Action required" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HomeRequiredActionDetail" Text="Choose your DCS Saved Games folder to continue." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" LineHeight="14" TextWrapping="Wrap" Margin="0,3,0,6" />
                                                <Button x:Name="HomeRequiredActionButton" Style="{StaticResource GlassPrimaryButton}" Content="Choose DCS folder" Margin="0" HorizontalAlignment="Stretch" Click="HomeRequiredActionButton_Click" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="HomeUpdateStatusText" Text="Checking for updates" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                        <!-- ==================== Flights ==================== -->
                        <Grid x:Name="TelemetryPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Flights" Style="{StaticResource PageTitle}" />
                                    <TextBlock Text="Record a flight, then see which effects your shakers received and how hard." Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="RecordingStatusText" Text="Recorder stopped · completed recordings are analyzed after Stop" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartRecordingButton" Style="{StaticResource GlassPrimaryButton}" Content="Start" ToolTip="Start recording" Click="StartRecordingButton_Click" />
                                    <Button x:Name="StopRecordingButton" Style="{StaticResource SecondaryButton}" Content="Stop" IsEnabled="False" Click="StopRecordingButton_Click" />
                                    <Button Style="{StaticResource CompactButton}" Content="Import" ToolTip="Import recording" Click="ImportRecordingButton_Click" />
                                    <Button Style="{StaticResource CompactButton}" Content="Open folder" Click="OpenRecordingsButton_Click" />
                                    <Button x:Name="TelemetryLogToggle" Style="{StaticResource CompactButton}" Content="Telemetry log" Margin="0" Click="TelemetryLogToggle_Click" />
                                </StackPanel>
                            </Grid>

                                <Popup x:Name="TelemetryLogDrawer" PlacementTarget="{Binding ElementName=TelemetryLogToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Width="760" Height="236" Margin="0,8,0,0" Padding="14" Background="{DynamicResource LogBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Telemetry log" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="BusyText" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Margin="12,0,0,0" /></StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Close" Margin="0" Click="CloseTelemetryLogDrawerButton_Click" />
                                            </Grid>
                                            <TextBox x:Name="LogTextBox" Grid.Row="1" Style="{StaticResource AnalysisField}" FontFamily="Consolas" MinHeight="0" Margin="0,10,0,0" />
                                        </Grid>
                                    </Border>
                                </Popup>

                            <Grid Grid.Row="1">
                                <Border x:Name="FlightEmptyState" Style="{StaticResource Card}" Padding="10,8" MinHeight="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="FlightEmptyStateTitleText" Text="Recent flights" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="FlightEmptyStateDescriptionText" Text="Select a flight to review its telemetry and effects." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="RefreshRecentFlightsButton" Grid.Column="1" Style="{StaticResource WindowButton}" Width="30" Height="28" Content="&#xE72C;" ToolTip="Refresh recent recordings" Click="RefreshRecentFlightsButton_Click" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,7,0,0">
                                            <TextBlock x:Name="RecentFlightsHintText" Visibility="Collapsed" />
                                            <Grid x:Name="FlightEmptyContentPanel" Visibility="Collapsed" />
                                            <Grid x:Name="RecentFlightsSidebarPanel" Visibility="Visible">
                                                <ScrollViewer x:Name="RecentFlightsScrollViewer"
                                                              Height="260"
                                                              VerticalAlignment="Top"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              PanningMode="VerticalOnly"
                                                              CanContentScroll="False"
                                                              PreviewMouseWheel="AnalysisScrollViewer_PreviewMouseWheel">
                                                    <WrapPanel x:Name="RecentFlightsPanel" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid x:Name="FlightDashboard" Visibility="Collapsed" Margin="0" Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="FlightDashboardTitle" Text="Flight analysis" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="FlightDashboardMeta" Text="Recording details" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="RecordingSelectorComboBox" Visibility="Collapsed" Style="{StaticResource EffectFilterComboBox}" Width="235" Height="34" Margin="0,0,8,0" SelectionChanged="RecordingSelectorComboBox_SelectionChanged" ToolTip="Switch between recent recordings" />
                                            <Button x:Name="NewRecordingButton" Style="{StaticResource CompactPrimaryButton}" Content="New recording" Click="NewRecordingButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Open recordings" Click="OpenRecordingsButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Replay controls" Click="ReplayDashboardButton_Click" />
                                            <Button x:Name="DashboardImportButton" Style="{StaticResource CompactButton}" Content="Import..." Click="ImportRecordingButton_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="ReplayDashboardCard" Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,10" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DashboardModeTitleText" Text="Recording replay" FontSize="13.5" FontWeight="SemiBold" /><Ellipse x:Name="DashboardModeDot" Width="6" Height="6" Fill="{DynamicResource Warning}" Margin="10,0,5,0" /><TextBlock x:Name="DashboardModeStatusText" Text="PAUSED" Foreground="{DynamicResource Warning}" FontSize="10.5" FontWeight="Bold" /></StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="AnalysisEffectsFilterButton" Style="{StaticResource SecondaryButton}" Content="Effects" MinWidth="170" Height="34" Margin="0" Click="AnalysisEffectsFilterButton_Click" AutomationProperties.Name="Filter recording effects" />
                                                    <Popup x:Name="AnalysisEffectsFilterPopup" PlacementTarget="{Binding ElementName=AnalysisEffectsFilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                        <Border Width="390" Height="340" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="14">
                                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Filter effects" FontSize="15" FontWeight="SemiBold" /><Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Reset" Margin="0" Click="AnalysisEffectsResetButton_Click" /></Grid>
                                                                <TextBox x:Name="AnalysisEffectSearchTextBox" Grid.Row="1" Margin="0,10,0,8" ToolTip="Search effects" TextChanged="AnalysisEffectSearchTextBox_TextChanged" />
                                                                <WrapPanel Grid.Row="2" Margin="0,0,0,8"><Button Style="{StaticResource CompactButton}" Content="Active" Click="AnalysisEffectsActiveButton_Click" /><Button Style="{StaticResource CompactButton}" Content="Unused" Click="AnalysisEffectsUnusedButton_Click" /><Button Style="{StaticResource CompactButton}" Content="All" Click="AnalysisEffectsAllButton_Click" /><Button Style="{StaticResource CompactButton}" Content="Clear" Margin="0" Click="AnalysisEffectsClearButton_Click" /></WrapPanel>
                                                                <ScrollViewer Grid.Row="3" MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="AnalysisEffectCategoryPanel" /><Border Height="1" Background="{DynamicResource PanelBorder}" Margin="0,8" /><StackPanel x:Name="AnalysisEffectChecklistPanel" /></StackPanel></ScrollViewer>
                                                                <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="AnalysisEffectFilterCountText" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Done" Margin="0" Click="AnalysisEffectsDoneButton_Click" /></Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Popup>
                                                    <CheckBox x:Name="HideUnusedEffectsCheckBox" Visibility="Collapsed" IsChecked="True" Checked="HideUnusedEffectsCheckBox_Changed" Unchecked="HideUnusedEffectsCheckBox_Changed" />
                                                    <ComboBox x:Name="EffectIsolationComboBox" Visibility="Collapsed" SelectionChanged="EffectIsolationComboBox_SelectionChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel x:Name="AnalysisFilterChipsPanel" Grid.Row="2" Margin="0,8,0,0" />
                                            <Grid x:Name="ReplayControlsPanel" Grid.Row="1" Margin="0,9,0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                                <Button x:Name="ReplayPlayPauseButton" Style="{StaticResource CompactButton}" Content="Play" MinWidth="62" Click="ReplayPlayPauseButton_Click" />
                                                <WrapPanel Grid.Column="1"><Button Style="{StaticResource CompactButton}" Content="−10s" Click="ReplayBackButton_Click" /><Button Style="{StaticResource CompactButton}" Content="+10s" Click="ReplayForwardButton_Click" /></WrapPanel>
                                                <Slider x:Name="ReplayPositionSlider" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="ReplayPositionSlider_ValueChanged" Margin="8,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ReplayPositionText" Grid.Column="3" Text="0:00 / 0:00" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
