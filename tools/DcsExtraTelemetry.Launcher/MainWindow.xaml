                        <StackPanel x:Name="InstallationPage" Visibility="Collapsed"><Grid Height="48" Margin="0,0,0,10"><StackPanel><TextBlock Text="HapticFlight Bridge / Setup" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><TextBlock Text="Setup" FontSize="18" FontWeight="Bold" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,86,0"></StackPanel></Grid>
