                        <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                            <TextBlock Text="Options" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Display, local connection, and application update preferences." Style="{StaticResource PageSubtitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Date and time" Style="{StaticResource PanelTitle}" />
                                        <TextBlock Text="Choose the formats used for flight recordings and dashboard dates." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14" />
                                        <TextBlock Text="Time" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <ComboBox x:Name="TimeFormatComboBox" Style="{StaticResource EffectFilterComboBox}" MinHeight="34" Margin="0,4,0,12">
                                            <ComboBoxItem Content="12-hour · 6:50 PM" Tag="12Hour" />
                                            <ComboBoxItem Content="24-hour · 18:50" Tag="24Hour" />
                                        </ComboBox>
                                        <TextBlock Text="Date" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                        <ComboBox x:Name="DateFormatComboBox" Style="{StaticResource EffectFilterComboBox}" MinHeight="34" Margin="0,4,0,10">
                                            <ComboBoxItem Content="US · 9/26/2026" Tag="US" />
                                            <ComboBoxItem Content="Day first · 26/09/2026" Tag="DayFirst" />
                                            <ComboBoxItem Content="ISO · 2026-09-26" Tag="Iso" />
                                        </ComboBox>
                                        <TextBlock x:Name="DisplayFormatPreviewText" Text="Preview" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Appearance" Style="{StaticResource PanelTitle}" />
                                        <TextBlock Text="Pick the look that is easiest to read. System follows your Windows app theme." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14" />
                                        <WrapPanel>
                                            <Button x:Name="SystemThemeButton" Style="{StaticResource PillButton}" Content="System" Click="SystemThemeButton_Click" />
                                            <Button x:Name="LightThemeButton" Style="{StaticResource PillButton}" Content="Light" Click="LightThemeButton_Click" />
                                            <Button x:Name="DarkThemeButton" Style="{StaticResource PillButton}" Content="Dark" Click="DarkThemeButton_Click" />
                                        </WrapPanel>
                                        <TextBlock Text="Your choices are saved on this PC." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Connection" Style="{StaticResource PanelTitle}" />
                                        <TextBlock Text="Local ports on this PC. Telemetry never leaves your computer." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SimHub port" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBox x:Name="SimHubPortTextBox" Text="29381" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Recorder port" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBox x:Name="RecorderPortTextBox" Text="29382" IsReadOnly="True" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Recorder port is managed automatically." Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,5,0,8" />
                                        <TextBlock x:Name="PortSettingsStatusText" Text="Defaults are ready." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource CompactPrimaryButton}" Content="Save ports" Click="SavePortSettingsButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Find available" Click="FindAvailablePortsButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Launch monitor" Click="LaunchMonitorButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Updates" Style="{StaticResource PanelTitle}" />
                                        <TextBlock x:Name="UpdateStatusText" Text="Checking for updates..." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14" />
                                        <WrapPanel>
                                            <Button x:Name="ApplyUpdateButton" Style="{StaticResource GlassPrimaryButton}" Content="Download update" IsEnabled="False" Click="ApplyUpdateButton_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="Check now" Click="CheckForUpdatesButton_Click" />
                                            <Button x:Name="SignInToGitHubButton" Style="{StaticResource LinkButton}" Content="Sign in to GitHub" Margin="4,0,0,0" Click="SignInToGitHubButton_Click" Visibility="Collapsed" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

