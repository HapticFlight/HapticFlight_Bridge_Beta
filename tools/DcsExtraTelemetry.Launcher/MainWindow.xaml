er Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Primary}"><TextBlock Text="3" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="Verify in DCS" FontSize="13" FontWeight="Bold" /><TextBlock Text="After installing" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /></StackPanel></StackPanel></Border></UniformGrid></StackPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource Card}" MinHeight="400" Margin="0,0,0,18"><StackPanel><TextBlock Text="STEP 1" FontSize="11" Foreground="{DynamicResource SelectedAccent}" FontWeight="Bold" /><TextBlock Text="Choose your folders" FontSize="16" FontWeight="Bold" /><TextBlock Text="Detected automatically. Change them if DCS or SimHub lives somewhere else." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,12" /><Grid><TextBlock Text="DCS Saved Games profile" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Browse…" Click="AddDcsProfileButton_Click" Style="{StaticResource CompactButton}" Margin="0" HorizontalAlignment="Right"/></Grid><StackPanel x:Name="DcsProfilesPanel" Margin="0,10,0,0"/><Border Background="{DynamicResource LogBackground}" CornerRadius="12" Padding="13" Margin="0,7,0,0"><StackPanel><TextBlock Text="Selected profile" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><TextBlock Text="{Binding Text, ElementName=RedesignProfileNameText}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border><Separator Margin="0,16"/><Grid><TextBlock Text="SimHub folder" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Browse…" Click="ChooseSimHubButton_Click" Style="{StaticResource CompactButton}" Margin="0" HorizontalAlignment="Right"/></Grid><Border Background="{DynamicResource LogBackground}" CornerRadius="12" Padding="13" Margin="0,7,0,0"><StackPanel><TextBlock Text="Installation folder" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><TextBlock Text="{Binding Text, ElementName=SimHubPathText}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border><Border Style="{StaticResource Card}" MinHeight="340"><StackPanel><TextBlock Text="STEP 2" FontSize="11" Foreground="{DynamicResource SelectedAccent}" FontWeight="Bold" /><TextBlock Text="Install components" FontSize="16" FontWeight="Bold" /><TextBlock Text="Install both with the button above, or one at a time here." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,16" /><UniformGrid Columns="2"><Border Style="{StaticResource Card}" Background="{DynamicResource LogBackground}" Margin="0,0,10,0"><StackPanel><TextBlock Text="DCS hook" FontSize="16" FontWeight="Bold" /><TextBlock Text="Sends flight data from DCS to SimHub over a local connection. DCS loads it automatically." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,12" /><TextBlock Text="{Binding Text, ElementName=RedesignHookStateText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><Button Content="Install hook" Click="InstallDcsHookButton_Click" Style="{StaticResource GlassPrimaryButton}" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="{DynamicResource LogBackground}" Margin="0"><StackPanel><TextBlock Text="SimHub plugin" FontSize="16" FontWeight="Bold" /><TextBlock Text="Turns flight data into the DCSExtra properties used by ShakeIt effects." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,12" /><TextBlock Text="{Binding Text, ElementName=RedesignPluginStateText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><Button Content="Install plugin" Click="InstallSimHubPluginButton_Click" Style="{StaticResource GlassPrimaryButton}" Margin="0,14,0,0"/></StackPanel></Border></UniformGrid><Border Background="{DynamicResource WarnBadgeBackground}" BorderBrush="#80694D20" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,16,0,0"><TextBlock Text="Close DCS and SimHub before installing or removing. Restart both afterwards." FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" /></Border></StackPanel></Border></StackPanel><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="STEP 3" FontSize="11" Foreground="{DynamicResource SelectedAccent}" FontWeight="Bold" /><TextBlock Text="Verify in DCS" FontSize="16" FontWeight="Bold" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Primary}" Width="21" Height="21" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Restart DCS and SimHub." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Primary}" Width="21" Height="21" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="2" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Start any mission. In SimHub, DCSExtra.Connected should turn true." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Primary}" Width="21" Height="21" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="3" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Import only the profile for the aircraft you are flying." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Primary}" Width="21" Height="21" CornerRadius="6" VerticalAlignment="Top"><TextBlock Text="4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Start with amplifier volume low and SimHub output gain at 50% or less." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Grid></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="What gets changed" FontSize="16" FontWeight="Bold" /><TextBlock Text="✓  Only HapticFlight Bridge files are written, each recorded with a SHA-256 fingerprint." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" /><TextBlock Text="✓  Export.lua and other mods’ hooks are never changed." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" /><TextBlock Text="✓  If a different file is already there, it is backed up first." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" BorderBrush="#665F223C" BorderThickness="1"><StackPanel><TextBlock Text="Uninstall" FontSize="16" FontWeight="Bold" /><TextBlock Text="Remove hook and plugin" FontSize="12" FontWeight="Bold" Margin="0,12,0,5" /><TextBlock Text="Remove only HapticFlight Bridge files from DCS and SimHub, then verify. Your other mods, profiles and recordings stay." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><Button Content="Remove and verify" Click="CompleteRollbackButton_Click" Style="{StaticResource CompactButton}" Foreground="{DynamicResource Danger}" Margin="0,12,0,12"/><TextBlock Text="Uninstall the app" FontSize="12" FontWeight="Bold" /><TextBlock Text="Remove HapticFlight Bridge from this PC." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"  /><Button Content="Uninstall HapticFlight Bridge…" Click="UninstallApplicationButton_Click" Style="{StaticResource CompactButton}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></Grid>
</StackPanel>

