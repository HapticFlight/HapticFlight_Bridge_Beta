<Window x:Class="DcsExtraTelemetry.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HapticFlight Bridge" Icon="Assets/HapticFlightOrangeIcon.ico" Width="1440" Height="940" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="20" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot" Background="{DynamicResource BackdropBase}">
        <!-- Soft pools of warm and cool light: a stand-in for the blurred photo behind the glass. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0.2" GradientOrigin="0.12,0.2" RadiusX="0.6" RadiusY="0.55">
                    <GradientStop Color="{DynamicResource BackdropWarmColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.88,0.12" GradientOrigin="0.88,0.12" RadiusX="0.5" RadiusY="0.6">
                    <GradientStop Color="{DynamicResource BackdropTealColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.6,1.05" GradientOrigin="0.6,1.05" RadiusX="0.7" RadiusY="0.5">
                    <GradientStop Color="{DynamicResource BackdropPurpleColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BackdropTransparentColor}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- The reference screens are authored as a full desktop composition.  The
             launcher itself opens at a compact DIP size on high-DPI Windows, so fit
             that one composition uniformly instead of allowing its fixed controls
             to grow past their intended proportions. -->
        <Grid x:Name="WindowScaleViewbox" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="WindowFrame" Width="1280" Background="Transparent" BorderThickness="0" CornerRadius="10">
        <Border.LayoutTransform><ScaleTransform x:Name="WindowCompositionScale" ScaleX="1" ScaleY="1" /></Border.LayoutTransform>
        <Grid x:Name="AmbientBackdrop" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <!-- Persistent navigation mirrors the supplied desktop reference: clear product
                 identity, five task-focused destinations, and no hidden mode switching. -->
            <Border Grid.Column="0" Margin="18" Background="{DynamicResource GlassSidebarSurface}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" CornerRadius="18" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Width="32" Height="32" Background="{DynamicResource Primary}" CornerRadius="8" VerticalAlignment="Center">
                            <Path Data="M3.5,14 L7.5,14 L10.2,7.5 L15.4,20.5 L18.4,12 L20.2,14 L24.5,14" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="28" Height="28" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>
                        <TextBlock Text="HAPTICFLIGHT" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="TopNavigationPanel" Grid.Row="1" Margin="0,12,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="OverviewNavButton" Style="{StaticResource ActiveNavButton}" Click="OverviewNavButton_Click" AutomationProperties.Name="Dashboard">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewNavIcon" Style="{StaticResource NavIcon}" Text="&#xE80F;" /><TextBlock x:Name="OverviewNavLabel" Text="Dashboard" /></StackPanel>
                        </Button>
                        <Button x:Name="InstallationNavButton" Style="{StaticResource NavButton}" Click="InstallationNavButton_Click" AutomationProperties.Name="Setup">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="InstallationNavIcon" Style="{StaticResource NavIcon}" Text="&#xE896;" /><TextBlock x:Name="InstallationNavLabel" Text="Setup" /></StackPanel>
                        </Button>
                        <Button x:Name="TelemetryNavButton" Style="{StaticResource NavButton}" Click="TelemetryNavButton_Click" AutomationProperties.Name="Flights">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="TelemetryNavIcon" Style="{StaticResource NavIcon}" Text="&#xE709;" /><TextBlock x:Name="TelemetryNavLabel" Text="Flights" /></StackPanel>
                        </Button>
                        <TextBlock Text="TOOLS" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="12,18,0,10" />
                        <Button x:Name="AircraftNavButton" Style="{StaticResource NavButton}" Click="AircraftNavButton_Click" AutomationProperties.Name="Aircraft">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE709;" /><TextBlock Text="Aircraft" /></StackPanel>
                        </Button>
                        <Button x:Name="DiagnosticsNavButton" Style="{StaticResource NavButton}" Click="DiagnosticsNavButton_Click" AutomationProperties.Name="Support">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="DiagnosticsNavIcon" Style="{StaticResource NavIcon}" Text="&#xE90F;" /><TextBlock x:Name="DiagnosticsNavLabel" Text="Support" /></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Visibility="Collapsed" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click" AutomationProperties.Name="Options"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SettingsNavIcon" Style="{StaticResource NavIcon}" Text="&#xE713;" /><TextBlock x:Name="SettingsNavLabel" Text="Options" /></StackPanel></Button>
                    </StackPanel>
                    <Border Grid.Row="2" CornerRadius="12" Padding="13" Margin="0,12,0,0"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FF0060D5" Offset="0"/><GradientStop Color="#FF1C2045" Offset="0.6"/><GradientStop Color="#FF6A4BD8" Offset="1"/></LinearGradientBrush></Border.Background>
                        <StackPanel><TextBlock Text="Need help?" FontWeight="Bold" /><TextBlock Text="Install, profile and tuning guides" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,8" /><Button Style="{StaticResource CompactButton}" Content="SETUP GUIDE" Margin="0" HorizontalAlignment="Stretch" Click="OpenGuideButton_Click" /></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="2,0,18,14">
                <!-- The reference places its page breadcrumb/title in the same top band
                     as search and connection state; do not reserve a second header row. -->
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="4,12,4,0" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FlightSearchTextBox" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Search flights" Width="202" VerticalAlignment="Center" Margin="0,0,12,0" KeyDown="FlightSearchTextBox_KeyDown" TextChanged="FlightSearchTextBox_TextChanged" AutomationProperties.Name="Search flights by aircraft or map" />
                    <StackPanel x:Name="TopStatusPill" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Local connection on this PC. Telemetry never leaves your computer.">
                        <Ellipse x:Name="TitleStatusIndicator" Width="8" Height="8" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleStatusText" Text="Setup required" FontWeight="Bold" FontSize="12.5" /><TextBlock x:Name="TitleStatusDetailText" Text="Checking setup" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeWindowButton_Click" />
                        <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaximizeWindowButton_Click" />
                        <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="CloseWindowButton_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Margin="0,-54,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
                    <StackPanel x:Name="ActionArea" Margin="4,0,4,12">

                        <!-- ==================== Dashboard ==================== -->
                        <Grid x:Name="OverviewPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="DashboardMainPanel" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                <TextBlock Text="Flight dashboard" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="DashboardSetupPanel" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.25*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="SetupBadge" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Danger}" BorderBrush="{DynamicResource DangerHover}" BorderThickness="2" VerticalAlignment="Top">
                                            <TextBlock x:Name="SetupBadgeGlyph" Text="!" FontWeight="ExtraBold" FontSize="17" Foreground="{DynamicResource DangerText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Setup" Style="{StaticResource PanelTitle}" />
                                            <TextBlock x:Name="SetupSummaryText" Text="Checking" Foreground="{DynamicResource Warning}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="HomeProfileIndicator" Width="7" Height="7" Fill="{DynamicResource Danger}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="DCS profile" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeProfileNameText" Text="No DCS profile selected" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=HomeProfilePathText}" />
                                                <TextBlock x:Name="HomeProfilePathText" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock x:Name="HomeProfileStateText" Grid.Column="2" Text="Required" Foreground="{DynamicResource Danger}" FontSize="11" FontWeight="Bold" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DashboardSimHubIndicator" Width="7" Height="7" Fill="{DynamicResource Warning}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="SimHub" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeSimHubPathText" Text="Not detected" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Click="ChooseSimHubButton_Click" VerticalAlignment="Top" Padding="2,0"><TextBlock x:Name="HomeSimHubStateText" Text="Choose..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Warning}" /></Button>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="DCS hook" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomeHookStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button x:Name="HomeHookInstallButton" Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="Install" Margin="0" VerticalAlignment="Center" Click="InstallDcsHookButton_Click" />
                                            <Border x:Name="HomeHookInstalledBadge" Grid.Column="1" Style="{StaticResource InstalledBadge}" Visibility="Collapsed"><TextBlock Text="Installed" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="Bold" /></Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="SimHub plugin" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                <TextBlock x:Name="HomePluginStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button x:Name="HomePluginInstallButton" Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="Install" Margin="0" VerticalAlignment="Center" Click="InstallSimHubPluginButton_Click" />
                                            <Border x:Name="HomePluginInstalledBadge" Grid.Column="1" Style="{StaticResource InstalledBadge}" Visibility="Collapsed"><TextBlock Text="Installed" Foreground="{DynamicResource Success}" FontSize="11" FontWeight="Bold" /></Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="App release" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                            <TextBlock x:Name="HomePackageVersionText" Grid.Column="1" Text="Loading" FontSize="10" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                        <Border x:Name="HomeRequiredActionCard" Background="{DynamicResource GlassSurfaceSubtle}" CornerRadius="10" Padding="11,9" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="HomeRequiredActionTitle" Text="Action required" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock x:Name="HomeRequiredActionDetail" Text="Choose your DCS Saved Games folder to continue." Foreground="{DynamicResource TextSecondary}" FontSize="10.5" LineHeight="14" TextWrapping="Wrap" Margin="0,3,0,6" />
                                                <Button x:Name="HomeRequiredActionButton" Style="{StaticResource GlassPrimaryButton}" Content="Choose DCS folder" Margin="0" HorizontalAlignment="Stretch" Click="HomeRequiredActionButton_Click" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="HomeUpdateStatusText" Text="Checking for updates" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                        <!-- ==================== Flights ==================== -->
                        <Grid x:Name="TelemetryPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,18">
<Grid Height="48" Margin="0,0,0,10"><StackPanel><TextBlock Text="HapticFlight Bridge / Flights" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="Flights" FontSize="18" FontWeight="Bold"/></StackPanel></Grid>
<Grid Height="258"><Grid.ColumnDefinitions><ColumnDefinition Width="0.62*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border CornerRadius="18" Padding="21"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FF060D30" Offset="0.3"/><GradientStop Color="#FF07448F" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel>
<TextBlock Text="Flight recorder" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
<TextBlock x:Name="ReferenceRecorderClock" Text="0:00" FontSize="48" FontWeight="Bold" Margin="0,6,0,0"/>
<TextBlock x:Name="RecordingStatusText" Text="Ready on port 29382" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
<TextBlock Text="Record a DCS flight, then see which effects your profile modelled and how strongly." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,20"/>
<WrapPanel><Button x:Name="StartRecordingButton" Style="{StaticResource GlassPrimaryButton}" Content="●  Start recording" Click="StartRecordingButton_Click"/><Button x:Name="StopRecordingButton" Style="{StaticResource SecondaryButton}" Content="Stop" IsEnabled="False" Click="StopRecordingButton_Click"/></WrapPanel>
</StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><StackPanel><Grid><TextBlock Text="Saved flights" FontSize="16" FontWeight="Bold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Import…" Click="ImportRecordingButton_Click" Style="{StaticResource CompactButton}"/><Button x:Name="RefreshRecentFlightsButton" Content="Refresh" Click="RefreshRecentFlightsButton_Click" Style="{StaticResource CompactButton}"/></StackPanel></Grid>
<TextBlock Text="Lossless .jsonl.gz · every telemetry packet kept" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,12"/>
<Grid x:Name="RecentFlightsSidebarPanel"><ScrollViewer x:Name="RecentFlightsScrollViewer" Height="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="AnalysisScrollViewer_PreviewMouseWheel"><WrapPanel x:Name="RecentFlightsPanel"/></ScrollViewer></Grid>
</StackPanel></Border></Grid>
</StackPanel>

<Popup x:Name="TelemetryLogDrawer" PlacementTarget="{Binding ElementName=TelemetryLogToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border Width="760" Height="236" Margin="0,8,0,0" Padding="14" Background="{DynamicResource LogBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="Telemetry log" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="BusyText" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Margin="12,0,0,0" /></StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Close" Margin="0" Click="CloseTelemetryLogDrawerButton_Click" />
                                            </Grid>
                                            <TextBox x:Name="LogTextBox" Grid.Row="1" Style="{StaticResource AnalysisField}" FontFamily="Consolas" MinHeight="0" Margin="0,10,0,0" />
                                        </Grid>
                                    </Border>
                                </Popup>

                            <Grid Grid.Row="1">
                                <Border x:Name="FlightEmptyState" Style="{StaticResource Card}" MinHeight="470">
<StackPanel><Grid><StackPanel><TextBlock Text="Flight analysis" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock x:Name="FlightEmptyStateTitleText" Text="Choose a flight" FontSize="22" FontWeight="Bold" Margin="0,4,0,4"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Open folder" Click="OpenRecordingsButton_Click" Style="{StaticResource CompactButton}"/><Button x:Name="TelemetryLogToggle" Content="Telemetry log" Click="TelemetryLogToggle_Click" Style="{StaticResource CompactButton}"/></StackPanel></Grid>
<TextBlock x:Name="FlightEmptyStateDescriptionText" Text="Select a saved flight above, import a recording, or record a new flight." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
<UniformGrid Columns="5" HorizontalAlignment="Left" Margin="0,20,0,15"><Button Content="Timeline" Style="{StaticResource GlassPrimaryButton}" IsEnabled="False"/><Button Content="Flight phases" Style="{StaticResource CompactButton}" IsEnabled="False"/><Button Content="Combined load" Style="{StaticResource CompactButton}" IsEnabled="False"/><Button Content="Telemetry" Style="{StaticResource CompactButton}" IsEnabled="False"/><Button Content="Debrief" Style="{StaticResource CompactButton}" IsEnabled="False"/></UniformGrid>
<Border Background="{DynamicResource LogBackground}" CornerRadius="16" Height="290"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Choose a recording to see its timeline" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Modelled from recorded telemetry and profile logic." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock Text="Not a measurement of SimHub output or shaker response." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
<TextBlock x:Name="RecentFlightsHintText" Visibility="Collapsed"/><Grid x:Name="FlightEmptyContentPanel" Visibility="Collapsed"/>
</StackPanel></Border>

<Grid x:Name="FlightDashboard" Visibility="Collapsed" Margin="0" Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="FlightDashboardTitle" Text="Flight analysis" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="FlightDashboardMeta" Text="Recording details" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox x:Name="RecordingSelectorComboBox" Visibility="Collapsed" Style="{StaticResource EffectFilterComboBox}" Width="235" Height="34" Margin="0,0,8,0" SelectionChanged="RecordingSelectorComboBox_SelectionChanged" ToolTip="Switch between recent recordings" />
                                            <Button x:Name="NewRecordingButton" Style="{StaticResource CompactPrimaryButton}" Content="New recording" Click="NewRecordingButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Open recordings" Click="OpenRecordingsButton_Click" />
                                            <Button Style="{StaticResource CompactButton}" Content="Replay controls" Click="ReplayDashboardButton_Click" />
                                            <Button x:Name="DashboardImportButton" Style="{StaticResource CompactButton}" Content="Import..." Click="ImportRecordingButton_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2">
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Style="{StaticResource GlassPillBar}"><WrapPanel><Button x:Name="TimelineTabButton" Style="{StaticResource AnalysisTabButtonActive}" Content="Timeline" Click="TimelineTabButton_Click" /><Button x:Name="PhaseTabButton" Style="{StaticResource AnalysisTabButton}" Content="Flight phases" Click="PhaseTabButton_Click" /><Button x:Name="LoadTabButton" Style="{StaticResource AnalysisTabButton}" Content="Combined load" Click="LoadTabButton_Click" /><Button x:Name="TelemetryTabButton" Style="{StaticResource AnalysisTabButton}" Content="Telemetry" Click="TelemetryTabButton_Click" /><Button x:Name="DebriefTabButton" Style="{StaticResource AnalysisTabButton}" Content="Debrief" Click="DebriefTabButton_Click" /></WrapPanel></Border><TextBlock Grid.Column="1" Text="One view at a time · filters apply to every view" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center" /></Grid>
                                        <TextBlock x:Name="AnalysisEmptyStateText" Text="No effects match the current filters. Clear filters to restore the analysis." Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Margin="2,0,0,10" Visibility="Collapsed" />
                                    <Border x:Name="TimelineTabPanel" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,11">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryAirframe}" Margin="0,3,5,0" /><TextBlock Text="Airframe" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryRotor}" Margin="0,3,5,0" /><TextBlock Text="Rotor" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryGround}" Margin="0,3,5,0" /><TextBlock Text="Ground" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" Margin="0,0,14,0" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource ChartCategoryWeapons}" Margin="0,3,5,0" /><TextBlock Text="Weapons" Foreground="{DynamicResource TextSecondary}" FontSize="9.5" />
