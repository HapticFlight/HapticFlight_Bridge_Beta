                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2">
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Style="{StaticResource GlassPillBar}"><WrapPanel><Button x:Name="TimelineTabButton" Style="{StaticResource AnalysisTabButtonActive}" Content="Timeline" Click="TimelineTabButton_Click" /><Button x:Name="PhaseTabButton" Style="{StaticResource AnalysisTabButton}" Content="Flight phases" Click="PhaseTabButton_Click" /><Button x:Name="LoadTabButton" Style="{StaticResource AnalysisTabButton}" Content="Combined load" Click="LoadTabButton_Click" /><Button x:Name="TelemetryTabButton" Style="{StaticResource AnalysisTabButton}" Content="Telemetry" Click="TelemetryTabButton_Click" /><Button x:Name="DebriefTabButton" Style="{StaticResource AnalysisTabButton}" Content="Debrief" Click="DebriefTabButton_Click" /></WrapPanel></Border><TextBlock Grid.Column="1" Text="One view at a time · filters apply to every view" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center" /></Grid>
