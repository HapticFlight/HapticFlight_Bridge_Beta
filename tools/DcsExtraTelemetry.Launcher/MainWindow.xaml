                        <!-- Setup is managed from the Dashboard now. Keep the page name as a collapsed compatibility target. -->
                        <StackPanel x:Name="InstallationPage" Visibility="Collapsed" />

                        <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed" />

                        <!-- ==================== Dashboard ==================== -->
                        <StackPanel x:Name="SettingsPage" Visibility="Visible">
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Setup, recent flights, and aircraft at a glance." Style="{StaticResource PageSubtitle}" />

                            <Border Background="{DynamicResource GlassSurfaceSubtle}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="OverallStatusIndicator" Width="8" Height="8" Fill="{DynamicResource Danger}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Overall setup" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock x:Name="OneClickStatusText" Text="Checking your setup" Foreground="{DynamicResource TextPrimary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,12,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource CompactButton}" Content="Run checks" Click="AdvancedButton_Click" />
                                            <Button x:Name="OneClickInstallButton" Style="{StaticResource GlassPrimaryButton}" MinWidth="180" Padding="20,9" FontSize="13" Content="Install everything" Click="OneClickInstallButton_Click" ToolTip="Install or repair the DCS Hook and SimHub plugin." />
                                        </StackPanel>
                                        <Button x:Name="UninstallApplicationButton" Style="{StaticResource LinkButton}" Content="Uninstall HapticFlight Bridge" HorizontalAlignment="Right" Margin="0,5,0,0" Click="UninstallApplicationButton_Click" Visibility="Collapsed" AutomationProperties.Name="Uninstall HapticFlight Bridge" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Expander x:Name="AdvancedInstallOptionsExpander" IsExpanded="True" Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Manage DCS Hook and SimHub plugin" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  install or uninstall each component" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Style="{StaticResource Card}" Padding="12,11" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" /><ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource GlassStroke}" HorizontalAlignment="Center" />
                                    <Border Grid.Column="3" Width="1" Background="{DynamicResource GlassStroke}" HorizontalAlignment="Center" />

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="RedesignProfileIndicator" Style="{StaticResource StatusDot}" Fill="{DynamicResource Danger}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="DCS Saved Games" Style="{StaticResource PanelTitle}" />
                                            <TextBlock x:Name="RedesignProfileStateText" Grid.Column="2" Text="Required" Foreground="{DynamicResource Danger}" FontSize="10.5" FontWeight="Bold" />
                                        </Grid>
                                        <TextBlock Text="Step 1 · DCS profile" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,7,0,2" />
                                        <TextBlock x:Name="RedesignProfileNameText" Text="No profile found" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RedesignProfilePathText" Visibility="Collapsed" />
                                        <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="DcsProfilesPanel" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="DcsProfileConfirmationText" Text="Browse to your DCS Saved Games folder to add it." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,5" MaxHeight="28" />
                                        <WrapPanel>
                                            <Button x:Name="ConfirmDcsProfileButton" Style="{StaticResource GlassPrimaryButton}" Content="Confirm profile" Click="ConfirmDcsProfileButton_Click" Visibility="Collapsed" />
                                            <Button x:Name="BrowseDcsProfileButton" Style="{StaticResource CompactPrimaryButton}" Content="Browse for DCS folder" Margin="0" Click="AddDcsProfileButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <Border Height="1" Background="{DynamicResource GlassStroke}" Margin="0,2,0,8" />
                                        <TextBlock Text="2 · DCS telemetry Hook" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="RedesignHookStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="10.5" FontWeight="Bold" />
                                                <TextBlock x:Name="RedesignHookPrerequisiteText" Text="Confirm a DCS profile first" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="RedesignHookInstallButton" Grid.Column="1" Style="{StaticResource ComponentActionButton}" Content="Install" Margin="0,0,5,0" Click="InstallDcsHookButton_Click" />
                                            <Button x:Name="RedesignHookUninstallButton" Grid.Column="2" Style="{StaticResource ComponentRemoveButton}" Content="Uninstall" Margin="0" Click="RemoveDcsHookButton_Click" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="1 · Choose SimHub installation folder" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,7,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse x:Name="HomeSimHubIndicator" Style="{StaticResource StatusDot}" Fill="{DynamicResource Warning}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="SimHub" Style="{StaticResource PanelTitle}" />
                                            <TextBlock x:Name="RedesignSimHubStateText" Grid.Column="2" Text="Choose..." Foreground="{DynamicResource Warning}" FontSize="10.5" FontWeight="Bold" />
                                        </Grid>
                                        <TextBlock x:Name="SimHubPathText" Text="Not found" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" Margin="0,5,0,5" />
                                        <WrapPanel>
                                            <Button Style="{StaticResource CompactButton}" Content="Browse..." Click="ChooseSimHubButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <Border Height="1" Background="{DynamicResource GlassStroke}" Margin="0,2,0,8" />
                                        <TextBlock Text="2 · SimHub telemetry plugin" Foreground="{DynamicResource TextSecondary}" FontSize="10" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="RedesignPluginStateText" Text="Not installed" Foreground="{DynamicResource Danger}" FontSize="10.5" FontWeight="Bold" />
                                                <TextBlock x:Name="RedesignPluginPrerequisiteText" Text="Choose a SimHub folder first" Foreground="{DynamicResource Warning}" FontSize="9.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="RedesignPluginInstallButton" Grid.Column="1" Style="{StaticResource ComponentActionButton}" Content="Install" Margin="0,0,5,0" Click="InstallSimHubPluginButton_Click" />
                                            <Button x:Name="RedesignPluginUninstallButton" Grid.Column="2" Style="{StaticResource ComponentRemoveButton}" Content="Uninstall" Margin="0" Click="RemoveSimHubPluginButton_Click" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="2">
                                        <TextBlock Text="About" Style="{StaticResource PanelTitle}" Margin="0,0,0,5" />
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="App release" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" /><TextBlock x:Name="CurrentVersionText" Grid.Column="1" Text="?" FontSize="10.5" FontWeight="SemiBold" /></Grid>
                                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Built-in haptic engine" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" /><TextBlock x:Name="CurrentEngineVersionText" Grid.Column="1" Text="?" FontSize="10.5" FontWeight="SemiBold" /></Grid>
                                        <TextBlock Text="Engine and aircraft profile numbers are not app releases." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock x:Name="SidebarInstalledVersionText" Text="Installed plugin: checking" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="HomeEngineVersionText" Text="Engine version loading" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,3,0,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="HomeRollbackVersionText" Text="No public rollback release" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7" />
                                        <Button Style="{StaticResource CompactButton}" Content="Setup guide" Margin="0" HorizontalAlignment="Left" Click="OpenGuideButton_Click" />
                                    </StackPanel>

                                </Grid>
                                </Border>
                            </Expander>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Last flight" Style="{StaticResource PanelTitle}" />
                                                <TextBlock Text="Your most recent recording" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="OpenLastFlightButton" Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="Open analysis" Margin="0" Click="OpenLastFlightButton_Click" />
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource GlassSurfaceSubtle}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastFlightChipText" Text="No flights yet" Foreground="{DynamicResource TextSecondary}" FontSize="10.5" />
                                            </Border>
                                            <TextBlock x:Name="LastFlightEndText" Grid.Column="1" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="My aircraft" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Content="+ Import" Margin="0" ToolTip="Import a .jsonl flight recording" Click="ImportRecordingButton_Click" />
                                        </Grid>
                                        <StackPanel x:Name="MyAircraftPanel" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Expander x:Name="AdvancedExpander" Header="Advanced troubleshooting" IsExpanded="False" Visibility="Collapsed">
                                <StackPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Safety baseline" Style="{StaticResource PanelTitle}" /><TextBlock x:Name="BaselineStatusText" Text="Baseline not captured" Foreground="{DynamicResource Warning}" FontSize="12" Margin="0,4,0,0" /></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Verify package" Click="VerifyPackageButton_Click" /><Button Content="Capture baseline" Click="CaptureBaselineButton_Click" /><Button Content="Verify unchanged" Margin="0" Click="VerifyBaselineButton_Click" /></WrapPanel></Grid></Border>
                                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="DCS hook and monitor" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" /><WrapPanel Grid.Column="1"><Button Content="Install hook" Click="InstallDcsHookButton_Click" /><Button Style="{StaticResource DangerButton}" Content="Uninstall hook" Click="RemoveDcsHookButton_Click" /><Button Content="Launch monitor" Margin="0" Click="LaunchMonitorButton_Click" /></WrapPanel></Grid></Border>
                                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="SimHub plugin" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" /><WrapPanel Grid.Column="1"><Button Content="Install plugin" Click="InstallSimHubPluginButton_Click" /><Button Style="{StaticResource DangerButton}" Content="Remove plugin" Margin="0" Click="RemoveSimHubPluginButton_Click" /></WrapPanel></Grid></Border>
                                    <Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Complete rollback" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" /><WrapPanel Grid.Column="1"><Button Content="Open guide" Click="OpenGuideButton_Click" /><Button Style="{StaticResource DangerButton}" Content="Remove and verify" Margin="0" Click="CompleteRollbackButton_Click" /></WrapPanel></Grid></Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- Compatibility elements. MainWindow.xaml.cs still writes to these from the
                             earlier sidebar and step-strip layouts; they are kept, never shown, until
                             that code is trimmed. Nothing visible depends on them. -->
                        <StackPanel x:Name="LegacyStatusElements" Visibility="Collapsed">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="0" /></Grid.ColumnDefinitions></Grid>
                            <TextBlock x:Name="SidebarSectionTitle" />
                            <Button x:Name="SidebarToggleButton" Click="SidebarToggleButton_Click"><TextBlock x:Name="SidebarToggleGlyph" /></Button>
                            <Ellipse x:Name="SidebarFooterIndicator" /><TextBlock x:Name="SidebarFooterText" /><TextBlock x:Name="SidebarSimHubPortText" /><TextBlock x:Name="SidebarRecorderPortText" /><TextBlock x:Name="SidebarRollbackVersionText" />
                            <Ellipse x:Name="SidebarStatusIndicator" /><TextBlock x:Name="SidebarStatusText" />
                            <TextBlock x:Name="OverallStatusText" /><Ellipse x:Name="OverviewInstallStatusIndicator" />
                            <TextBox x:Name="OverviewSimHubPathText" /><TextBox x:Name="OverviewDcsPathText" /><TextBlock x:Name="OverviewTitleText" />
                            <TextBlock x:Name="DcsSummaryText" /><TextBlock x:Name="HookStatusText" /><TextBlock x:Name="PluginStatusText" /><TextBlock x:Name="SimHubSummaryText" />
                            <Border x:Name="HomeStep1Connector" /><Border x:Name="HomeStep1Disc"><TextBlock x:Name="HomeStep1Glyph" /></Border><TextBlock x:Name="HomeStep1Label" />
                            <Border x:Name="HomeStep2Connector" /><Border x:Name="HomeStep2Disc"><TextBlock x:Name="HomeStep2Glyph" /></Border><TextBlock x:Name="HomeStep2Label" />
                            <Border x:Name="HomeStep3Connector" /><Border x:Name="HomeStep3Disc"><TextBlock x:Name="HomeStep3Glyph" /></Border><TextBlock x:Name="HomeStep3Label" /><TextBlock x:Name="HomeStep3Detail" />
                            <Border x:Name="HomeStep4Disc"><TextBlock x:Name="HomeStep4Glyph" /></Border>
                            <TextBlock x:Name="RedesignStep1StatusText" /><TextBlock x:Name="RedesignStep1DetailText" /><TextBlock x:Name="RedesignStep2StatusText" /><TextBlock x:Name="RedesignStep3StatusText" /><TextBlock x:Name="RedesignStep4StatusText" />
                            <TextBlock x:Name="HomeRedesignTitle" /><TextBlock x:Name="HomeRedesignSubtitle" />
                            <Button x:Name="HomeGoToFlightsButton" Click="TelemetryNavButton_Click" />
                            <Button x:Name="ChooseDcsFolderButton" Click="AddDcsProfileButton_Click" /><Button x:Name="ChooseSimHubFolderButton" Click="ChooseSimHubButton_Click" />
                            <Ellipse x:Name="HomeSavedGamesIndicator" /><TextBlock x:Name="RedesignSavedGamesPathText" /><Button x:Name="RedesignSavedGamesActionButton" Click="AddDcsProfileButton_Click" /><TextBlock x:Name="RedesignSimHubPathText" />
                            <StackPanel x:Name="TelemetrySection"><TextBlock x:Name="DcsPathStatusText" /><TextBlock x:Name="BridgePathStatusText" /><TextBlock x:Name="SimHubPathStatusText" /></StackPanel>
                            <Expander x:Name="AdvancedRecorderPortExpander" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
