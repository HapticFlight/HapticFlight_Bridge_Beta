<Application x:Class="DcsExtraTelemetry.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <!-- The colors below are placeholders used only for design-time preview. At startup and on
             every theme change, App.xaml.cs's ApplyTheme() overwrites each of these brushes from the
             GlassThemePalette.DarkGlass dictionary (GlassThemePalette.cs), which is the single
             source of truth for hex values. Edit the palette there, not here. -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF242427" />
        <SolidColorBrush x:Key="PanelBackground" Color="#9E3A3A3E" />
        <SolidColorBrush x:Key="PanelSubtleBackground" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="InputBackground" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="LogBackground" Color="#F21E1E21" />
        <SolidColorBrush x:Key="PanelBorder" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#00000000" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#00000000" />
        <SolidColorBrush x:Key="ActiveNavBackground" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#F2333337" />
        <SolidColorBrush x:Key="Primary" Color="#FFFF6A2B" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#FFFF7F47" />
        <SolidColorBrush x:Key="PrimaryPressed" Color="#FFE85A1E" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="SecondaryButtonHover" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="SecondaryButtonPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="DisabledBackground" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="DisabledForeground" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="FocusRing" Color="#FFFF9A6B" />
        <SolidColorBrush x:Key="SelectedAccent" Color="#FFFF8A57" />
        <SolidColorBrush x:Key="Danger" Color="#FFFF7C86" />
        <SolidColorBrush x:Key="DangerHover" Color="#FFFF9AA1" />
        <SolidColorBrush x:Key="StatusError" Color="#FFFF7C86" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FFB9B9BE" />
        <SolidColorBrush x:Key="Success" Color="#FF6EE7A0" />
        <SolidColorBrush x:Key="Warning" Color="#FFF5B83D" />
        <SolidColorBrush x:Key="NeutralStatus" Color="#FF8E8E94" />
        <SolidColorBrush x:Key="ChartBackground" Color="#00000000" />
        <SolidColorBrush x:Key="ChartAxisBackground" Color="#00000000" />
        <SolidColorBrush x:Key="ChartLane" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="ChartPhaseBand" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="ChartGridMajor" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ChartGridMinor" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="ChartCursor" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ChartCategoryAirframe" Color="#FFC9C9CE" />
        <SolidColorBrush x:Key="ChartCategoryGround" Color="#FFF5B83D" />
        <SolidColorBrush x:Key="ChartCategoryWeapons" Color="#FFFF6A2B" />
        <SolidColorBrush x:Key="ChartCategoryRotor" Color="#FF34C759" />
        <SolidColorBrush x:Key="ScrollTrack" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="ScrollThumb" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ScrollThumbHover" Color="#52FFFFFF" />
        <BitmapImage x:Key="HeaderLogo" UriSource="Assets/HapticFlightLogoDark.png" />

        <!-- Local forwarders keep the original application-level contracts intact while
             the templates themselves live in GlassStyles.xaml. -->
        <Style TargetType="Button">
            <Style.BasedOn>
                <StaticResource ResourceKey="GlassButtonBase" />
            </Style.BasedOn>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassPrimaryButton}" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="False">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Primary}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledBackground}" /><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EffectFilterComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ActiveNavBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ActiveNavBackground}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SelectedAccent}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EffectFilterComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource EffectFilterComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid Margin="10,0,9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextPrimary}" TextElement.FontSize="12.5" /><TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusRing}" /></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="5" Margin="0,3,0,0" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Background" Value="{DynamicResource DisabledBackground}" /><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="15" Height="15" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CheckGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Primary}" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Primary}" /><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource FocusRing}" /><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource DisabledBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="RadioBorder" Width="15" Height="15" CornerRadius="8" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioDot" Width="7" Height="7" Fill="{DynamicResource Primary}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioDot" Property="Visibility" Value="Visible" /><Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource SelectedAccent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource FocusRing}" /><Setter TargetName="RadioBorder" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}" /><Setter TargetName="RadioBorder" Property="Background" Value="{DynamicResource DisabledBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{DynamicResource ChartLane}" CornerRadius="2" />
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="10" Height="18" Background="{DynamicResource Primary}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="SliderThumb" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource FocusRing}" BorderThickness="1" CornerRadius="3" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SliderThumb" Property="Background" Value="{DynamicResource PrimaryHover}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

















        <Style x:Key="CompactToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ActiveNavBackground}" /><Setter Property="Foreground" Value="{DynamicResource FocusRing}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>




        <Style x:Key="TelemetryScrollThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="10" /><Setter Property="MinHeight" Value="38" /><Setter Property="Margin" Value="2" /><Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="3" Opacity="0.82" /><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="1" /><Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" /></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Opacity" Value="1" /><Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{DynamicResource ScrollTrack}" CornerRadius="6" Margin="2,1"><Track x:Name="PART_Track" Margin="0,1" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource TelemetryScrollThumb}" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="14" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{DynamicResource ScrollTrack}" CornerRadius="6" Margin="1,2"><Track x:Name="PART_Track" Margin="1,0" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource TelemetryScrollThumb}" MinWidth="44" MinHeight="10" /></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PathField" TargetType="TextBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="ActivityRow" TargetType="Grid">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ActivityInfoIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource FocusRing}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <Style x:Key="AnalysisField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="MinHeight" Value="170" />
            <Setter Property="Padding" Value="13" />
            <Setter Property="Background" Value="{DynamicResource LogBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- The stock WPF DataGrid ignores the application palette and falls back to a
             white table.  The flight debrief needs to read as a compact event log. -->
        <Style x:Key="DebriefEventsGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelSubtleBackground}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="DebriefEventsHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="DebriefEventsCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActiveNavBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
